---
import { postMockList, type IPost } from "../models/post.model";
---

<section class="hero">
  <article class="principal-post-card">
    <section class="principal-post-card-info">
      <header class="principal-post-header">
        <h4 class="principal-post-category">{postMockList[0].category}</h4>
        <h2 class="principal-post-title">{postMockList[0].title}</h2>
      </header>
      <hr class="separator" />
      <div class="principal-post-description-cnt">
        <p class="principal-post-description">
          {postMockList[0].shortDescription}
        </p>
      </div>
      <hr class="separator" />
      <footer class="principal-post-footer">
        <p class="principal-post-author">
          <span class="principal-post-author">
            {postMockList[0].author}
          </span>
          <span class="principal-post-date">
            {postMockList[0].publishDate.toDateString()}
          </span>
        </p>
        <button class="principal-post-see-more-button">See more</button>
      </footer>
    </section>
    <section
      class="principal-post-image"
      style={`background-image: url(${postMockList[0].image})`}
    >
    </section>
  </article>
  <section class="hero-subcards">
    {postMockList.slice(1).map((post: IPost) => <h1>posts</h1>)}
  </section>

  <style>
    .hero {
      margin-top: 3rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .principal-post-card {
      min-height: 50vh;
      border-radius: 10px;
      display: grid;
      grid-template-columns: 3fr 7fr;
      gap: 0;
      background-color: var(--color-slate-navy);
      color: var(--color-soft-white);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
    .principal-post-card-info {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }
    .principal-post-date,
    .principal-post-description {
      font-size: 1rem;
      color: var(--color-soft-white);
      opacity: 0.6;
    }
    .principal-post-category {
      font-size: 1.125rem;
      color: var(--color-electric-blue); /* Maintains bright accent on hover */
      font-weight: bolder;
      cursor: pointer;
    }
    .principal-post-category:hover {
      text-shadow: 0px 0px 8px rgba(0, 191, 255, 0.6); /* Electric Blue glow */
    }
    .principal-post-author {
      font-size: 1rem;
      color: var(--color-soft-white);
      font-weight: bolder;
      cursor: pointer;
    }
    .principal-post-title {
      font-size: 2.375rem;
    }
    .principal-post-header {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .principal-post-footer {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
    }
    .principal-post-see-more-button {
      background-color: var(--color-dark-teal);
      color: var(--color-soft-white);
      font-size: 1.125rem;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      outline: none;
      padding: 0.75rem;
    }
    .principal-post-see-more-button:hover {
      background-color: var(--color-dark-teal); /* Dark Teal accent on hover */
      box-shadow: 0px 0px 10px rgba(0, 191, 255, 0.6); /* Electric Blue glow */
    }
    .separator {
      width: 80%;
      opacity: 0.2;
      margin-left: 0;
    }
    .principal-post-image {
      background-size: cover;
      background-position: center;
    }
    @media screen and (max-width: 600px) {
      .principal-post-card {
        display: flex;
        flex-direction: column-reverse;
        gap: 0;
      }
      .principal-post-image {
        height: 15rem;
      }
    }
    @media screen and (max-width: 1200px) {
      .principal-post-card {
        min-height: none;
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</section>
