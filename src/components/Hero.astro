---
import { postMockList, type IPost } from "../models/post.model";
import ColumnPost from "./ColumnPost.astro";
const { translation } = Astro.props;
import MainPost from "./MainPost.astro";
---

<section class="hero">
  <MainPost post={postMockList[0]} , translation={translation} />
  <section class="hero__posts-row">
    {
      postMockList
        .slice(1)
        .map((post: IPost) => (
          <ColumnPost post={post} translation={translation} />
        ))
    }
  </section>

  <style>
    .hero {
      margin-top: 3rem;
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }
    .card-post-category {
      font-size: 1rem;
    }
    .principal-post-category,
    .card-post-category {
      color: var(--color-electric-blue); /* Maintains bright accent on hover */
      font-weight: bolder;
      cursor: pointer;
    }
    .principal-post-category:hover,
    .card-post-category:hover {
      text-shadow: 0px 0px 8px rgba(0, 191, 255, 0.6); /* Electric Blue glow */
    }
    .principal-post-author {
      font-size: 1rem;
      color: var(--color-soft-white);
      font-weight: bolder;
      cursor: pointer;
    }
    .principal-post-title {
      font-size: 2.375rem;
    }
    .card-post-title {
      font-size: 1.5rem;
    }
    .principal-post-header {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .principal-post-footer {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
    }
    .principal-post-see-more-button {
      background-color: var(--color-dark-teal);
      color: var(--color-soft-white);
      font-size: 1.125rem;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      outline: none;
      padding: 0.75rem;
    }
    .principal-post-see-more-button:hover {
      background-color: var(--color-dark-teal); /* Dark Teal accent on hover */
      box-shadow: 0px 0px 10px rgba(0, 191, 255, 0.6); /* Electric Blue glow */
    }
    .separator {
      width: 80%;
      margin-left: 0;
    }
    .principal-post-image {
      background-size: cover;
      background-position: center;
    }
    .hero__posts-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .hero-subcard {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .card-image {
      height: 15rem;
      background-position: center;
      background-size: cover;
    }
    .hero-subcard {
      background-color: var(--color-slate-navy);
      color: var(--color-soft-white);
      border-radius: 10px;
    }
    @media screen and (max-width: 1200px) {
      .hero__posts-row {
        grid-template-columns: repeat(2, 1fr);
      }
      .principal-post-card {
        min-height: none;
        grid-template-columns: 1fr 1fr;
      }
    }
    @media screen and (max-width: 600px) {
      .hero__posts-row {
        grid-template-columns: 1fr;
      }
      .principal-post-card {
        display: flex;
        flex-direction: column-reverse;
        gap: 0;
      }
      .principal-post-image {
        height: 15rem;
      }
    }
  </style>
</section>
