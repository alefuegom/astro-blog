---
import type { IPost } from "../models/post.model";

interface Props {
  post: IPost;
  translation: any;
}
const { post, translation } = Astro.props;
---

<article class="main-post">
  <section class="main-post__content-cnt">
    <header class="main-post__content__header">
      <h4 class="main-post__content__category">{post.category}</h4>
      <h2 class="main-post__content__title">{post.title}</h2>
    </header>
    <hr class="separator" />
    <div class="main-post__description-cnt">
      <p class="main-post__description">
        {post.shortDescription}
      </p>
    </div>
    <hr class="separator" />
    <footer class="main-post__content__footer">
      <p class="main-post__content__author">
        <span>
          {post.author}
        </span>
        <span>
          {post.publishDate.toDateString()}
        </span>
      </p>
      <button class="main-post__content__see-more-button"
        >{translation["button.continue_reading"]}</button
      >
    </footer>
  </section>
  <section
    class="main-post__image"
    style={`background-image: url(${post.image})`}
  >
  </section>

  <style>
    .main-post {
      min-height: 50vh;
      border-radius: 10px;
      display: grid;
      grid-template-columns: 3fr 7fr;
      gap: 0;
      background-color: var(--color-slate-navy);
      color: var(--color-soft-white);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
    .main-post__content-cnt {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 1rem;
    }
    .main-post__description {
      font-size: 1rem;
      color: var(--color-soft-white);
    }
    .main-post__content__category {
      font-size: 1.125rem;
      color: var(--color-electric-blue); /* Maintains bright accent on hover */
      font-weight: bolder;
      cursor: pointer;
    }

    .main-post__conent__category:hover {
      text-shadow: 0px 0px 8px rgba(0, 191, 255, 0.6); /* Electric Blue glow */
    }
    .main-post__content__author {
      font-size: 1rem;
      color: var(--color-soft-white);
      font-weight: bolder;
      cursor: pointer;
    }
    .main-post__content__title {
      font-size: 2.375rem;
    }
    .main-post__content__header {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .main-post__content__footer {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .main-post__content__see-more-button {
      background-color: var(--color-dark-teal);
      color: var(--color-soft-white);
      font-size: 1.125rem;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      outline: none;
      padding: 0.75rem;
    }
    .main-post__content__see-more-button:hover {
      background-color: var(--color-dark-teal); /* Dark Teal accent on hover */
      box-shadow: 0px 0px 10px rgba(0, 191, 255, 0.6); /* Electric Blue glow */
    }
    .separator {
      width: 80%;
      margin-left: 0;
    }
    .main-post__image {
      background-size: cover;
      background-position: center;
      border-radius: 0px 10px 10px 0px;
    }
    @media screen and (max-width: 600px) {
      .main-post {
        display: flex;
        flex-direction: column-reverse;
        gap: 0;
      }
      .main-post__image {
        height: 15rem;
        border-radius: 10px 10px 0px 0px;
      }
    }
    @media screen and (max-width: 1200px) {
      .main-post {
        min-height: none;
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</article>
