---
import { postMockList, type IPost } from "../models/post.model";

interface Props {
  post: IPost;
  translation: any;
}
const { post, translation } = Astro.props;
---

<article class="column-post">
  <header
    class="column-post__image"
    style={`background-image: url(${post.image})`}
  >
  </header>
  <section class="column-post__content">
    <header class="column-post__content__header">
      <h4 class="column-post__content__category">{post.category}</h4>
      <h2 class="column-post__content__title">{post.title}</h2>
    </header>
    <hr class="separator" />
    <div>
      <p class="column-post__content__description">
        {post.shortDescription}
      </p>
    </div>
    <hr class="separator" />
    <footer class="column-post__footer">
      <p class="column-post__author">
        <span class="column-post__author">
          {postMockList[0].author}
        </span>
        <span class="column-post__date">
          {postMockList[0].publishDate.toDateString()}
        </span>
      </p>
      <button class="column-post__see-more-button"
        >{translation["button.continue_reading"]}</button
      >
    </footer>
  </section>
</article>

<style>
  .column-post {
    min-height: 50vh;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 0;
    background-color: var(--color-slate-navy);
    color: var(--color-soft-white);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }
  .column-post__image {
    height: 15rem;
    background-size: cover;
    background-position: center;
    border-radius: 10px 10px 0px 0px;
  }
  .column-post__content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    max-height: 25rem;
    justify-content: space-between;
  }
  .column-post__content__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .column-post__content__category {
    font-size: 1rem;
    color: var(--color-electric-blue); /* Maintains bright accent on hover */
    font-weight: bolder;
    cursor: pointer;
  }
  .column-post__content__category:hover {
    text-shadow: 0px 0px 8px rgba(0, 191, 255, 0.6); /* Electric Blue glow */
  }
  .column-post__content__author {
    font-size: 1rem;
    color: var(--color-soft-white);
    font-weight: bolder;
    cursor: pointer;
  }
  .column-post__content__title {
    font-size: 1.5rem;
  }
  .column-post__content__description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
    text-overflow: ellipsis;
    /* margin-top: 10px; */
    line-height: 1.5;
    max-height: calc(1.5em * 5);
  }
  .column-post__see-more-button {
    background-color: var(--color-dark-teal);
    color: var(--color-soft-white);
    font-size: 1.125rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    outline: none;
    padding: 0.75rem;
  }
  .column-post__see-more-button:hover {
    background-color: var(--color-dark-teal); /* Dark Teal accent on hover */
    box-shadow: 0px 0px 10px rgba(0, 191, 255, 0.6); /* Electric Blue glow */
  }
  .column-post__footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .separator {
    width: 80%;
    margin-left: 0;
  }
</style>
